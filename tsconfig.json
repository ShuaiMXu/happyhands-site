{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "guide",
    "apps/studio",
    "systems/happyhands",
    "systems/quartz",
    "packages/contracts",
    "packages/ui",
    "components",
    "systems/lime",
    "systems/sodium",
    "systems/glaze",
    "systems/design-how-main.tsx"
  ],
  "exclude": [
    "components/preview/adapters"
  ]
}
