{
  "name": "happyhands-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run ui:build && node scripts/release-metadata.mjs && npm run catalog:build && npm run systems:previews && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run catalog:build && npm run systems:previews && tsc --noEmit",
    "test:studio": "node --import tsx --test tests/studio-core.test.ts tests/studio-bridge.test.mjs",
    "test:studio:browser": "node tests/studio-browser.mjs",
    "test:studio:harness": "node --import tsx tests/studio-harness.ts",
    "tokens:build": "node scripts/brand-tokens.mjs",
    "test:studio:brand": "node tests/studio-brand-browser.mjs",
    "test:studio:fonts": "node tests/studio-font-browser.mjs",
    "test:studio:open-fonts": "node tests/studio-open-font-browser.mjs",
    "fonts:vendor": "node scripts/vendor-open-fonts.mjs",
    "test:site:browser": "node tests/site-flow-browser.mjs",
    "test:site:examples": "node tests/site-examples-export-browser.mjs",
    "catalog:build": "node scripts/build-cult-catalog.mjs",
    "catalog:sync": "node scripts/sync-cult-registry.mjs",
    "predev": "npm run ui:build && npm run catalog:build && npm run systems:previews",
    "test:components:browser": "node tests/component-library-browser.mjs",
    "test:components": "npm run catalog:build && node --test tests/component-catalog.test.mjs",
    "verify:alpha": "node --import tsx scripts/verify-alpha-release.mjs",
    "test:systems:browser": "node tests/design-system-reference-browser.mjs",
    "quartz:sync": "node scripts/sync-design-catalog.mjs quartz",
    "lime:sync": "node scripts/sync-design-catalog.mjs lime",
    "test:lime:browser": "node tests/lime-browser.mjs",
    "test:seo": "node --import tsx --test tests/site-seo.test.mjs",
    "test:seo:browser": "node tests/seo-browser.mjs",
    "test:analytics": "node --import tsx --test tests/site-analytics.test.ts",
    "test:analytics:browser": "node tests/site-analytics-browser.mjs",
    "check:search": "node scripts/check-search-discovery.mjs",
    "ui:audit": "node scripts/audit-owned-ui.mjs",
    "archive:facets": "node --import tsx scripts/build-archive-facets.mjs",
    "systems:previews": "node scripts/build-design-how-previews.mjs",
    "test:systems:live": "node tests/design-system-live-browser.mjs",
    "test:design-resources": "node --test tests/design-how.test.mjs tests/design-archive.test.mjs",
    "test:resources:browser": "node tests/resource-presentation-browser.mjs",
    "test:home:search": "node tests/home-resource-search-browser.mjs",
    "ui:build": "node scripts/prepare-shadcn.mjs && node scripts/build-shadcn.mjs && node scripts/build-component-runtime.mjs",
    "test:studio:reference": "node tests/studio-reference-browser.mjs"
  },
